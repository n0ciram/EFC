// Recursos del ayudante: manifiesto (DPI, compatibilidad) e información de versión.
1 24 "efc-helper.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0c0a04b0"
    BEGIN
      VALUE "CompanyName", "EFC"
      VALUE "FileDescription", "EFC - Ayudante del Explorador"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "efc-helper"
      VALUE "LegalCopyright", "n0ciram"
      VALUE "OriginalFilename", "efc-helper.exe"
      VALUE "ProductName", "EFC - Easy File Converter"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0c0a, 1200
  END
END
