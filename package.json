{
  "name": "efc-easy-file-converter",
  "productName": "EFC",
  "version": "1.6.0",
  "description": "EFC â€” Easy File Converter: rueda radial flotante para convertir archivos desde el Explorador de Windows.",
  "author": "n0ciram",
  "license": "GPL-3.0-or-later",
  "private": true,
  "main": "dist/electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build:helper": "node scripts/build-helper.mjs",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --import tsx --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test --test-reporter=spec \"tests/unit/**/*.test.ts\"",
    "test:conversion": "node --import tsx --test --test-reporter=spec \"tests/conversion/**/*.test.ts\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "prepare:win": "node scripts/prepare-win.mjs",
    "dist": "npm run build && npm run prepare:win && electron-builder --win nsis --x64 --publish never",
    "dist:dir": "npm run build && npm run prepare:win && electron-builder --win dir --x64 --publish never"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.11",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.9.3",
    "electron-builder": "26.17.0",
    "esbuild": "0.28.2",
    "ffmpeg-static": "5.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
